# =====================================================================
# Credenciais - copie para .env (gitignorado) antes de subir a stack
# =====================================================================

# ------------------------------------------------- Supabase (warehouse)
DBT_SUPABASE_HOST=aws-0-us-west-2.pooler.supabase.com
DBT_SUPABASE_PORT=6543
DBT_SUPABASE_USER=postgres.qkqwqvwloowvrexuzama
DBT_SUPABASE_DB=postgres
DBT_SUPABASE_PASSWORD=troque_pela_sua_senha

# ------------------------------------------------- Postgres local
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=dw_admin_local
POSTGRES_DB=enterprise

# ------------------------------------------------- Airflow
AIRFLOW_UID=50000
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin_local
# Webhook opcional: se preenchido, a DAG posta alerta markdown a cada falha.
# Ex.: a URL completa do Incoming Webhook do Slack (app do Slack em sua conta).
AIRFLOW_ALERT_WEBHOOK_URL=

# ------------------------------------------------- Metabase
METABASE_PORT=3000
# login inicial criado no bootstrap (scripts/metabase_bootstrap.ps1)
# precisa ser forte: o Metabase rejeita senhas "too common"
METABASE_ADMIN_EMAIL=admin@empresa.com
METABASE_ADMIN_PASSWORD=troque_uma_senha_forte_bem_longa
# role de banco usada pelo Metabase (somente leitura nos mart_*)
METABASE_DB_PASSWORD=troque_este_senha

# ------------------------------------------------- Adminer
ADMINER_PORT=8081
